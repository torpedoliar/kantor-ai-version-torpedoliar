# Copy this file to .env and fill in your router key.
# Without a key the server runs AI members in dry-run mode.
ANTHROPIC_API_KEY=
# Router base URL. Default https://api.anthropic.com; a local router (Anthropic-compatible) works too.
# ANTHROPIC_BASE_URL=http://127.0.0.1:20128
# Optional: fallback model when a member has no saved pick. The task dialog lists live router models per AI member.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: port for http://127.0.0.1:PORT
# PORT=3000
# Optional: 32-byte base64 (or 64-character hex) key for encrypted Settings credentials.
# When unset, a local data/settings.key is generated once on first use; back it up, credentials
# cannot be decrypted without it. Deleting it while the environment key differs loses stored keys.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# KANTOR_SETTINGS_KEY=
# Optional: pre-installed Docker image for approved application jobs. Server never pulls it automatically.
# KANTOR_RUNNER_IMAGE=node:22-alpine
# Optional: automatic retry backoff for transient provider failures, and synthesis retry limits.
# KANTOR_RETRY_DELAYS_MS=30000,120000,480000
# KANTOR_SYNTH_ATTEMPTS=3
# KANTOR_SYNTH_RETRY_DELAYS_MS=30000,120000
# Optional: how long a decision waits before one reminder (default 15 minutes).
# KANTOR_DECISION_SLA_MS=900000
# Optional: project retention (newest revisions kept, job output age in days).
# KANTOR_KEEP_REVISIONS=20
# KANTOR_JOB_MAX_AGE_DAYS=30
